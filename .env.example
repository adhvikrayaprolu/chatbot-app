# Ordinary chat: demo (offline, no model), ollama (local) or openai (any OpenAI-compatible API).
CHAT_PROVIDER=demo
# Compose host port; native Python startup uses port 5000.
CHAT_PORT=5000

# Local models. Document answering always runs here so private PDFs never leave the machine.
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_CHAT_MODEL=qwen3:4b
LOCAL_EMBED_MODEL=embeddinggemma

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: point at vLLM, LM Studio or another OpenAI-compatible server.
OPENAI_BASE_URL=

# Optional: stable secret for deployments; locally generated in instance/session.key
SECRET_KEY=
COOKIE_SECURE=false
